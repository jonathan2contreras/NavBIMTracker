# Copia a deploy/.env en el servidor y rellena. deploy/.env esta en .gitignore: nunca lo subas.

# Dominio publico (sin https:// ni barra final).
DOMAIN=grcontreras.es

# Credenciales de MongoDB (solo red interna). Valores sin simbolos raros: `openssl rand -hex 24`
MONGO_USER=navtracker
MONGO_PASSWORD=cambia-esto
DB_NAME=navtracker

# Contrasena compartida para entrar como administrador (sin ella solo se puede ver).
ADMIN_PASSWORD=cambia-esto
# Clave para firmar sesiones: `openssl rand -hex 32`
JWT_SECRET=cambia-esto

# Opcional. Dejala vacia: las fotos se guardan en el servidor (volumen 'uploads').
EMERGENT_LLM_KEY=
